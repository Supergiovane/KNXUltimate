# Copy this file to .env.knx-test and enable it only when running tests
# against a real KNX installation. .env.knx-test is ignored by Git.
KNX_TEST_ENABLED=false

# Connection
KNX_TEST_PROTOCOL=TunnelTCP
KNX_TEST_GATEWAY_IP=192.168.1.4
KNX_TEST_GATEWAY_PORT=3671
KNX_TEST_INTERFACE=
KNX_TEST_PHYS_ADDR=
KNX_TEST_SECURE=true
KNX_TEST_LOG_LEVEL=debug
KNX_TEST_CONNECT_TIMEOUT_MS=15000

# KNX Secure. Use the ETS keyring fields, the manual tunnel fields, or both.
KNX_TEST_KEYRING_PATH=
KNX_TEST_KEYRING_PASSWORD=
KNX_TEST_TUNNEL_IA=
KNX_TEST_TUNNEL_USER_ID=
KNX_TEST_TUNNEL_PASSWORD=
KNX_TEST_DEVICE_AUTH_PASSWORD=

# Optional real GroupValueWrite. Keep disabled for a connection-only test.
KNX_TEST_WRITE_ENABLED=false
KNX_TEST_WRITE_GA=
KNX_TEST_WRITE_DPT=19.001
# JSON value. Examples: true, 21.5, {"red":255,"green":0,"blue":0}
# For a JSON string, retain the inner double quotes as shown below.
KNX_TEST_WRITE_VALUE_JSON='"2026-07-31T12:30:00"'
KNX_TEST_WRITE_ACK_TIMEOUT_MS=5000
KNX_TEST_POST_WRITE_WAIT_MS=2000
